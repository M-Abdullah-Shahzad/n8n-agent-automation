      "id": "19c5eff2-70a2-4a00-9ac2-1e9407e15b10",
      "name": "Step 1: Get Login Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        -1760,
        112
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// 1. HTML se captcha question nikalein\nconst html = $('Step 1: Get Login Page').item.json.data;\n\n// Regex to find \"X + Y\" or \"X - Y\" pattern\nconst match = html.match(/(\\d+)\\s*([\\+\\-])\\s*(\\d+)\\s*=\\s*\\?/);\n\nlet answer = 0;\nif (match) {\n    const num1 = parseInt(match[1]);\n    const operator = match[2];\n    const num2 = parseInt(match[3]);\n    \n    if (operator === '+') {\n        answer = num1 + num2;\n    } else if (operator === '-') {\n        answer = num1 - num2;\n    }\n}\n\n// 2. CSV data ko forward karein\nreturn {\n  json: {\n    ...$json,  // Yeh email, password, role, sab kuch pass karega\n    captcha_answer: answer.toString()\n  }\n}"
      },
      "id": "af7f16f9-e357-4a9e-9651-699672f5915b",
      "name": "Step 2: Solve CAPTCHA Math",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1536,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5000/login",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "email",
              "value": "={{ $('Loop Over Items').item.json.email }}"
            },
            {
              "name": "password",
              "value": "={{ $('Loop Over Items').item.json.password }}"
            },
            {
              "name": "captcha",
              "value": "={{ $('Step 2: Solve CAPTCHA Math').item.json.captcha_answer }}"
            },
            {
              "name": "username",
              "value": "={{ $('Loop Over Items').item.json.full_name }}"
            },
            {
              "name": "role",
              "value": "student"
            }
          ]
        },
        "options": {
          "redirect": {
            "redirect": {}
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "def19ea8-f834-41a6-9b27-980d83adb33c",
      "name": "Step 3: Submit Login + CAPTCHA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        -1328,
        112
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const step3Item = $('Step 3: Submit Login + CAPTCHA').first();\nconst headers = step3Item.json.headers || {};\nconst setCookie = headers['set-cookie'] || headers['Set-Cookie'];\n\nlet cleanSession = '';\n\nif (Array.isArray(setCookie) && setCookie.length > 0) {\n    // Pehli cookie lein\n    const cookieString = setCookie[0];\n    // Sirf \"session=value\" part lein (semicolon se pehle)\n    cleanSession = cookieString.split(';')[0].trim();\n}\n\nreturn {\n    json: {\n        session: cleanSession\n    }\n}"
      },
      "id": "72f7e220-89e7-49a5-a23a-0ebeb4bf42ad",
      "name": "Step 4: Extract Auth Session",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1104,
        112
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "return {\n  json: {\n    full_name: $('Loop Over Items').item.json.full_name || '',\n    email: $('Loop Over Items').item.json.email || '',\n    password: $('Loop Over Items').item.json.password || '',\n    phone: $('Loop Over Items').item.json.phone || '',\n    website: $('Loop Over Items').item.json.website || '',\n    age: $('Loop Over Items').item.json.age?.toString() || '25',\n    birthdate: $('Loop Over Items').item.json.birthdate || '',\n    appointment: $('Loop Over Items').item.json.appointment || '',\n    alarm_time: $('Loop Over Items').item.json.alarm_time || '',\n    color: $('Loop Over Items').item.json.color || '#0d6efd',\n    satisfaction: $('Loop Over Items').item.json.satisfaction?.toString() || '5',\n    volume: $('Loop Over Items').item.json.volume?.toString() || '50',\n    country: $('Loop Over Items').item.json.country || '',\n    gender: $('Loop Over Items').item.json.gender || '',\n    education: $('Loop Over Items').item.json.education || '',\n    hobbies: $('Loop Over Items').item.json.hobbies || '',\n    skills: $('Loop Over Items').item.json.skills || '',\n    terms: $('Loop Over Items').item.json.terms || 'yes',\n    // Session token bhi chahiye\n    session: $json.session || $json.auth_token\n  }\n}"
      },
      "id": "7ef594e9-6bce-4df3-885b-ceda60da2a5e",
      "name": "Step 5: Set All Form Field Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5000/all-inputs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "=Cookie",
              "value": "={{ $('Step 4: Extract Auth Session').first().json.session }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"full_name\": \"{{ $json.full_name }}\",\n  \"email\": \"{{ $json.email }}\",\n  \"phone\": \"{{ $json.phone }}\",\n  \"website\": \"{{ $json.website }}\",\n  \"age\": {{ $json.age }},\n  \"birthdate\": \"{{ $json.birthdate }}\",\n  \"appointment\": \"{{ $json.appointment }}\",\n  \"alarm_time\": \"{{ $json.alarm_time }}\",\n  \"color\": \"{{ $json.color }}\",\n  \"satisfaction\": {{ $json.satisfaction }},\n  \"volume\": {{ $json.volume }},\n  \"country\": \"{{ $json.country }}\",\n  \"gender\": \"{{ $json.gender }}\",\n  \"education\": \"{{ $json.education }}\",\n  \"hobbies\": \"{{ $json.hobbies }}\",\n  \"skills\": \"{{ $json.skills }}\",\n  \"terms\": \"{{ $json.terms }}\"\n}",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": true
            }
          }
        }
      },
      "id": "4231471f-4388-401c-aeb6-7bf50163763b",
      "name": "Step 6: Submit All Input Form",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        -656,
        112
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// $json automatically refers to the current item's data in \"Each Item\" mode\nconst html = $json.data || '';\n\n// Check if response contains submissions page\nconst isSuccess = html.includes('Recent Submissions') && \n                  html.includes('All Inputs Form Submissions') &&\n                  html.includes('table');\n\n// Optional: Check if our email is in the submissions\nconst hasOurData = html.includes('john.doe+1@example.com');\n\nreturn {\n  json: {\n    data: html,\n    is_success: isSuccess || hasOurData,\n    submission_time: new Date().toISOString(),\n    debug: {\n      hasRecentSubmissions: html.includes('Recent Submissions'),\n      hasOurData: hasOurData,\n      htmlLength: html.length\n    }\n  }\n}"
      },
      "id": "7eed4131-afe5-4859-a89a-b34238e9f3f0",
      "name": "Step 7: Check Submit Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
